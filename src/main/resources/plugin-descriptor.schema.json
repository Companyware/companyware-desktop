{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://companyware.de/schemas/desktop/plugin-descriptor-v1.schema.json",
  "title": "Companyware Desktop Plugin Descriptor v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "author", "version", "requiredApiVersion", "entryPoint", "capabilities"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$" },
    "name": { "type": "string", "minLength": 1 },
    "author": { "type": "string", "minLength": 1 },
    "version": { "$ref": "#/$defs/semanticVersion" },
    "requiredApiVersion": { "$ref": "#/$defs/semanticVersion" },
    "entryPoint": { "type": "string", "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*(?:\\.[A-Za-z_$][A-Za-z0-9_$]*)+$" },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$" }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "minimumVersion"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$" },
          "minimumVersion": { "$ref": "#/$defs/semanticVersion" }
        }
      }
    },
    "priority": { "type": "integer", "default": 0 }
  },
  "$defs": {
    "semanticVersion": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" }
  }
}
