package __JAVA_PACKAGE__;

import javax.swing.JLabel;
import javax.swing.JPanel;
import platform.api.plugin.Plugin;
import platform.api.plugin.PluginContext;

/** Minimal SDK-only plugin generated by the standalone starter. */
public final class __ENTRY_CLASS__ implements Plugin {
    public static final String VIEW_ID = "starter.view";

    @Override
    public void initialize(final PluginContext context) {
        context.addView(VIEW_ID, "__DISPLAY_NAME_JAVA__", 120,
                () -> panel("__DISPLAY_NAME_JAVA__ is ready."));
        context.addNavigation("starter.navigation", "__DISPLAY_NAME_JAVA__", 120, VIEW_ID);
    }

    private static JPanel panel(String text) {
        JPanel panel = new JPanel();
        panel.add(new JLabel(text));
        return panel;
    }
}
